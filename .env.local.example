# ==============================================================================
# EDUQUEST RPG - ENVIRONMENT CONFIGURATION
# ==============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=eduquest-super-secret-key-replace-with-openssl-rand-base64-32

# Google OAuth (Optional - untuk login Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Upstash Redis Storage (Optional - fallback ke in-memory / IndexedDB jika kosong)
# Nama UPSTASH_* adalah format resmi Upstash. Nama KV_* lama dari integrasi
# Vercel juga masih dibaca oleh adapter Eduquest.
UPSTASH_REDIS_REST_URL=https://region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-api-token
# Legacy Vercel integration variables (optional)
KV_URL=redis://default:token@region.upstash.io:port
KV_REST_API_URL=https://region.upstash.io
KV_REST_API_TOKEN=your-redis-rest-api-token
KV_REST_API_READ_ONLY_TOKEN=your-redis-read-only-token

# Google Gemini AI API Key (gratis di https://aistudio.google.com/apikey)
# Key baru dari AI Studio biasanya diawali AQ. (auth key). Key lama AIza... juga masih bisa.
GEMINI_API_KEY=your-gemini-api-key
# Opsional: override model. Default mengikuti Flash terbaru yang tersedia.
# GEMINI_MODEL=gemini-3.7-flash
